# Copie para ".env" e ajuste. Sem este arquivo, a aplicação usa http://localhost:3000.
# Endereço base da API (sem "/projetos" no final). Só vale em desenvolvimento:
# "npm run build" usa o .env.production (/api).
#
# Back-end deste repositório (npm run dev em backend/):
VITE_API_URL=http://localhost:3001/api
#
# API simulada com json-server (npm run api):
# VITE_API_URL=http://localhost:3000
