# Copie para ".env" e ajuste. Sem este arquivo, valem os padrões abaixo.

# Porta da API (e da aplicação, quando o front-end compilado é servido).
PORT=3001

# Modo de execução. Use "production" ao implantar: desliga o CORS padrão e o
# modo de desenvolvimento do Express. Deixe comentado em desenvolvimento.
# NODE_ENV=production

# Endereço do front-end autorizado a chamar a API (CORS).
# Padrão em desenvolvimento: http://localhost:5173. Em produção: nenhum (não
# é necessário, pois o front-end é servido pela própria API).
# CORS_ORIGIN=http://localhost:5173

# Pasta com o front-end compilado (relativa à pasta backend).
# É servida se existir (rode "npm run build" em frontend/).
PASTA_FRONTEND=../frontend/dist

# Banco onde os projetos são gravados: "mongodb" ou "postgres". É lido uma vez,
# ao iniciar a aplicação. Só a string de conexão do banco escolhido é usada.
BANCO=mongodb

# Endereço do MongoDB. O padrão serve para o container do README (docker run ...).
# Com usuário e senha: mongodb://usuario:senha@localhost:27017/gerenciador-projetos?authSource=admin
MONGODB_URI=mongodb://localhost:27017/gerenciador-projetos

# Endereço do PostgreSQL (acessado pelo Prisma). O padrão serve para o container
# do README. Antes do primeiro uso, crie as tabelas: npm run prisma:migrar
POSTGRES_URL=postgresql://psw:psw@localhost:5432/gerenciador_projetos

# Segredo que assina o cookie da sessão. Troque por um valor longo e aleatório
# ao implantar. Sem esta variável, vale um segredo só de desenvolvimento.
SESSION_SECRET=troque-este-segredo

# Envie "true" só se a aplicação for servida por HTTPS. Em HTTP local o cookie
# seguro não é gravado pelo navegador.
# SESSION_COOKIE_SECURE=true
