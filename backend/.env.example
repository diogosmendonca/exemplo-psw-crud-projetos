# Copie para ".env" e ajuste. Sem este arquivo, valem os padrões abaixo.

# Porta da API.
PORT=3001

# Endereço do front-end autorizado a chamar a API (CORS).
CORS_ORIGIN=http://localhost:5173

# Arquivo JSON onde os projetos são gravados (relativo à pasta backend).
# Se não existir, é criado a partir de dados/projetos.exemplo.json.
ARQUIVO_DADOS=dados/projetos.json
