// Schema do PostgreSQL, usado quando BANCO=postgres. O endereço do banco vem
// de POSTGRES_URL (veja prisma.config.js); ele não fica aqui no Prisma 7.
//
// Depois de alterar este arquivo:
//   npm run prisma:nova-migracao -- --name descricao-da-mudanca
//   npm run prisma:gerar

generator client {
  // Gera o cliente em JavaScript. O gerador novo ("prisma-client") gera
  // TypeScript, que precisaria de um passo de compilação para rodar no Node.
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StatusProjeto {
  ativo
  inativo

  @@map("status_projeto")
}

enum PerfilUsuario {
  administrador
  gerente

  @@map("perfil_usuario")
}

model Cliente {
  id        Int       @id @default(autoincrement())
  nome      String    @db.VarChar(100)
  // Nome em minúsculas, único: "Acme" e "ACME" são o mesmo cliente (o mesmo
  // papel do índice com collation no MongoDB).
  nomeChave String    @unique @map("nome_chave") @db.VarChar(100)
  projetos  Projeto[]

  @@map("cliente")
}

model Projeto {
  id          Int           @id @default(autoincrement())
  nome        String
  status      StatusProjeto
  descricao   String        @default("")
  tecnologias String[]      @default([])
  url         String        @default("")
  clienteId   Int?          @map("cliente_id")
  cliente     Cliente?      @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@map("projetos")
}

// Cada projeto será de um único usuário. Essa ligação ainda não existe:
// por enquanto só o cadastro de usuário está pronto.
model Usuario {
  id               Int           @id @default(autoincrement())
  nome             String        @db.VarChar(100)
  email            String        @unique @db.VarChar(254)
  nomeUsuario      String        @map("nome_usuario") @db.VarChar(50)
  // Nome de usuário em minúsculas, único: "Ana" e "ana" são a mesma pessoa
  // (o mesmo papel do índice com collation no MongoDB).
  nomeUsuarioChave String        @unique @map("nome_usuario_chave") @db.VarChar(50)
  // Hash bcrypt. A senha em texto nunca é gravada nem devolvida.
  senhaHash        String        @map("senha_hash")
  perfil           PerfilUsuario

  @@map("usuario")
}
